# Bu dosyayı ".env" olarak kopyalayın.
# SQLite için dosya yolu yeterlidir; üretimde PostgreSQL/MySQL bağlantı dizesi girin
# ve prisma/schema.prisma içindeki datasource provider değerini güncelleyin.
DATABASE_URL="file:./dev.db"

# none: yönlendirme başlıkları yok sayılır. nginx/tek güvenilir proxy: hops:1
# İki güvenilir proxy: hops:2. Origin'e doğrudan erişimi kapatın.
# cloudflare: cf-connecting-ip kullanır; origin yalnızca Cloudflare'den trafik almalı.
TRUST_PROXY="none"
# Üretimde zorunlu: en az 32 rastgele bayttan oluşturulmuş kalıcı gizli anahtar.
# Değiştirilirse mevcut kullanılmamış davet kodları geçersiz olur.
INVITE_CODE_SECRET=""
# Seed/setup için üretim benzeri ortamdaki bilinçli istisna; reset için geçerli değil.
ALLOW_SEED="false"
# Boş bırakılırsa yerel seed güçlü rastgele bir parola üretip bir kez terminale yazar.
# Üretim benzeri seed için en az 12 karakterli, ortama özel parola belirleyin.
SEED_PASSWORD=""
# admin:create sırasında isteğe bağlı ADMIN_PASSWORD; normalde gizli terminal sorusu kullanılır.
